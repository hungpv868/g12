---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';

/**
 * English 404 — served for /en/* misses via the netlify.toml redirect rule.
 * Lives under /en so the header/footer localize to English automatically.
 */
---

<BaseLayout title="404 — G12 Media" description="The page you're looking for doesn't exist.">
  <section
    class="container-g12 flex min-h-[55vh] flex-col items-center justify-center py-16 text-center"
  >
    <p class="text-brand-gradient text-[6rem] leading-none font-extrabold md:text-[9rem]">404</p>
    <h1 class="mt-4 text-xl font-bold text-ink-strong md:text-2xl">
      The page you're looking for doesn't exist
    </h1>
    <p class="mt-1 text-sm text-ink-muted">The link may have changed or been removed.</p>
    <div class="mt-8">
      <Button href="/en/">Back to Home</Button>
    </div>
  </section>
</BaseLayout>
