---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import ThemeScript from '~/components/ThemeScript.astro';
import { alternatePath, getLangFromUrl, useTranslations } from '~/i18n/utils';
import { languages, type Lang } from '~/i18n/ui';
import { site } from '~/config/site';

/**
 * Root layout for EVERY page. Header and Footer are declared only here —
 * child pages must not rebuild them.
 */
interface Props {
  title: string;
  description: string;
  /** Page-specific OG image path; falls back to the brand card */
  ogImage?: string;
  /** Set for blog posts: switches og:type to article and emits BlogPosting JSON-LD */
  article?: { published: Date };
}

const { title, description, ogImage, article } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Meta description caps at ~158 chars — search engines truncate beyond that
const metaDesc =
  description.length > 158 ? description.slice(0, 155).replace(/\s+\S*$/, '') + '…' : description;

const ogUrl = new URL(ogImage ?? '/og-default.jpg', Astro.site).href;

// Directory-style URLs end with a trailing slash — keep alternates consistent
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const altHref = (code: Lang) => new URL(withSlash(alternatePath(Astro.url, code)), Astro.site).href;

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: Astro.site?.href,
    logo: new URL('/og-default.jpg', Astro.site).href,
    email: site.email,
    sameAs: [site.social.facebook, site.social.tiktok],
  },
];
if (article) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: metaDesc,
    image: ogUrl,
    datePublished: article.published.toISOString(),
    inLanguage: lang,
    author: { '@type': 'Organization', name: site.name },
    publisher: { '@type': 'Organization', name: site.name },
    mainEntityOfPage: canonical.href,
  });
}
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical.href} />

    {(Object.keys(languages) as Lang[]).map((code) => (
      <link rel="alternate" hreflang={code} href={altHref(code)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={altHref('vi')} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    {article && (
      <meta property="article:published_time" content={article.published.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ThemeScript />
  </head>

  {/* overflow-x-clip, NOT -hidden: hidden turns <body> into a scroll container,
    which silently breaks the sticky header. clip blocks sideways overflow the
    same way without creating a scroll container. */}
  <body class="min-h-screen overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-surface-raised focus:px-5 focus:py-2.5 focus:font-bold focus:text-brand-orange"
    >
      {t('a11y.skipToContent')}
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal .reveal blocks once when they enter the viewport
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
