---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Glow from '../Glow.astro';
import { categories, recentWidget, relatedByCategory } from '~/data/blog';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

/**
 * Blog detail — layout chung của 6 frame Figma (Desktop-3…8):
 * breadcrumb chấm màu → H1 cam → byline "G12 MEDIA | thứ, dd/mm/yyyy - 20:00"
 * → ảnh bìa → nội dung (H2 cam) + sidebar phải (BÀI VIẾT MỚI ×4, CHUYÊN MỤC)
 * → BÀI VIẾT LIÊN QUAN ×3 → footer gọn.
 */
interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(post);

const cat = categories[post.data.category];
const blogBase = localizePath(routes.blog, lang);

// Byline đúng định dạng thiết kế: "Thứ tư, 11/02/2026 - 20:00"
const dateStr = new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', {
  weekday: 'long',
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
}).format(post.data.date);
const byline = `${dateStr.charAt(0).toUpperCase() + dateStr.slice(1)} - 20:00`;

// Loại chính bài đang đọc khỏi danh sách liên quan (Figma: bài Matilia hiện
// Choi's ở vị trí đầu và ngược lại), lấy đúng 3 mục
const related = (relatedByCategory[post.data.category] ?? relatedByCategory.casestudy!)
  .filter((item) => item.title.vi !== post.data.title && item.title.en !== post.data.title)
  .slice(0, 3);
---

<BaseLayout
  title={`${post.data.title} — G12 Media`}
  description={post.data.excerpt}
  footerVariant="compact"
>
  <article class="relative overflow-hidden py-10 md:py-14">
    <Glow side="right" top="5%" size="520px" />

    <div class="container-g12 grid gap-10 lg:grid-cols-[1fr_300px] lg:gap-14">
      <div class="min-w-0">
        <p class="flex items-center gap-2 text-xs font-bold tracking-wide text-ink-muted uppercase">
          <span class="size-2 rounded-full" style={`background:${cat.dot}`}></span>
          {cat.label[lang]}
        </p>

        <h1 class="mt-3 text-2xl leading-snug font-bold text-brand-accent uppercase md:text-[28px]">
          {post.data.title}
        </h1>

        <p class="mt-4 flex flex-wrap items-center gap-2 text-xs text-ink-muted">
          <span class="font-bold text-brand-orange">{t('blog.by')}</span>
          <span aria-hidden="true">|</span>
          <time datetime={post.data.date.toISOString()}>{byline}</time>
        </p>

        <Image
          src={post.data.cover}
          alt=""
          widths={[720, 1440]}
          sizes="(min-width: 1024px) 848px, 100vw"
          loading="eager"
          class="mt-6 w-full rounded-[18px]"
        />

        <div
          class="prose-g12 mt-8 flex flex-col gap-4 text-sm leading-[1.75] text-ink md:text-[15px]"
        >
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="flex flex-col gap-10">
        <section aria-label={t('blog.recent')}>
          <h2 class="border-b-2 border-brand-orange pb-2 text-sm font-bold text-ink-strong">
            {t('blog.recent')}
          </h2>
          <ul class="mt-4 flex flex-col gap-4">
            {
              recentWidget.map((item) => (
                <li class="flex items-start gap-3">
                  <Image
                    src={item.img}
                    alt=""
                    width={120}
                    densities={[1, 2]}
                    loading="lazy"
                    class="aspect-square w-[74px] shrink-0 rounded-lg object-cover"
                  />
                  {/* Bài chưa có nội dung — hiển thị không link, đúng trạng thái */}
                  <p
                    class="line-clamp-3 text-xs leading-snug font-bold text-ink"
                    title={t('blog.comingSoon')}
                  >
                    {item.title[lang]}
                  </p>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-label={t('blog.categories')}>
          <h2 class="border-b-2 border-brand-orange pb-2 text-sm font-bold text-ink-strong">
            {t('blog.categories')}
          </h2>
          <ul class="mt-4 flex flex-col">
            {
              (Object.keys(categories) as (keyof typeof categories)[]).map((key) => (
                <li>
                  <a
                    href={blogBase}
                    class="flex items-center gap-2.5 border-b border-line py-2.5 text-xs font-semibold text-ink transition hover:text-brand-orange"
                  >
                    <span class="size-2 rounded-full" style={`background:${categories[key].dot}`} />
                    {categories[key].label[lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>

    <!-- Bài viết liên quan -->
    <section class="container-g12 mt-14 md:mt-20" aria-label={t('blog.related')}>
      <h2 class="text-sm font-bold text-ink-strong uppercase">{t('blog.related')}</h2>
      <ul class="mt-5 grid gap-6 sm:grid-cols-3">
        {
          related.map((item) => (
            <li class="reveal overflow-hidden rounded-[16px] bg-surface-sunken shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-1">
              <Image
                src={item.img}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 640px) 370px, 100vw"
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
              <div class="p-4">
                <p class="line-clamp-2 text-xs leading-snug font-bold text-ink-strong">
                  {item.title[lang]}
                </p>
                <p class="mt-2 flex items-center gap-2 text-[0.65rem] font-bold text-ink-muted uppercase">
                  <span
                    class="size-1.5 rounded-full"
                    style={`background:${categories[item.category].dot}`}
                  />
                  {categories[item.category].label[lang]}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style is:global>
  /* Sub-heading trong bài: cam, đậm — theo mockup blog detail */
  .prose-g12 h2 {
    margin-top: 0.75rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-brand-accent);
  }
  .prose-g12 img {
    border-radius: 14px;
    margin-inline: auto;
  }
  .prose-g12 a {
    color: var(--color-brand-orange);
    text-decoration: underline;
  }
</style>
