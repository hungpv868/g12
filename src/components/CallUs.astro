---
import { Image } from 'astro:assets';
import ticketOrange from '~/assets/misc/ticket-orange.png';
import ticketCream from '~/assets/misc/ticket-cream.png';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

/**
 * Figma (Group 1244830931, 1238×507): 4 vé xếp 2×2, nghiêng nhẹ và gối lên nhau.
 * Hai biến thể nền lấy từ Figma:
 *  - ticket-orange: cam bên trái → kem bên phải, chữ trắng
 *  - ticket-cream : kem bên trái → cam bên phải, chữ #E94B23
 * Cuống vé bên phải có nút "Liên hệ" chữ xoay dọc.
 *
 * Dùng chung ở trang chủ, About Us và Dịch Vụ.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = localizePath(routes.services, lang);
const stub = lang === 'vi' ? 'Liên hệ' : 'Contact';

const tickets = [
  { label: t('home.services.s3.title'), bg: ticketOrange, dark: false, tilt: '-1.2deg' },
  { label: t('home.services.s1.title'), bg: ticketCream, dark: true, tilt: '1deg' },
  { label: t('home.services.s4.title'), bg: ticketCream, dark: true, tilt: '1.6deg' },
  { label: t('home.services.s2.title'), bg: ticketOrange, dark: false, tilt: '-1deg' },
];
---

<section class="py-12 md:py-16">
  <div class="container-g12">
    <h2 class="reveal text-3xl font-bold text-ink-strong sm:text-4xl md:text-[3.5rem]">
      {t('home.callus.title')}
    </h2>

    <ul class="mt-8 grid gap-5 md:mt-10 md:grid-cols-2 md:gap-x-10 md:gap-y-4">
      {
        tickets.map((item, i) => (
          <li
            class:list={[
              'reveal',
              /* hàng dưới thụt vào và gối lên hàng trên như bản thiết kế */
              i >= 2 && 'md:-mt-6 md:translate-x-6',
            ]}
            style={`--tilt:${item.tilt}`}
          >
            <a
              href={href}
              class="group relative block transition duration-300 hover:-translate-y-1 md:[transform:rotate(var(--tilt))] md:hover:[transform:rotate(var(--tilt))_translateY(-4px)]"
            >
              <Image
                src={item.bg}
                alt=""
                widths={[600, 1200]}
                sizes="(min-width: 768px) 560px, 100vw"
                loading="lazy"
                class="w-full drop-shadow-[0_8px_16px_rgba(0,0,0,0.18)]"
              />

              {/* Nhãn dịch vụ — canh giữa phần thân vé (72% bên trái) */}
              <span
                class:list={[
                  'absolute inset-y-0 left-0 grid w-[72%] place-items-center px-[8%] text-center text-xs leading-tight font-bold uppercase sm:text-sm md:text-base',
                  item.dark ? 'text-brand-deep' : 'text-white',
                ]}
              >
                {item.label}
              </span>

              {/* Nút trên cuống vé */}
              <span
                class="absolute top-1/2 right-[9.5%] grid h-[46%] w-[7%] -translate-y-1/2 place-items-center rounded-full bg-linear-to-b from-[#ffd23f] to-[#ff9f17] shadow-md transition group-hover:brightness-110"
              >
                <span
                  class="text-[0.5rem] font-bold text-white sm:text-[0.6rem] md:text-xs"
                  style="writing-mode: vertical-rl"
                >
                  {stub}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
