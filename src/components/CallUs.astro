---
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

/**
 * Khối "Call us if you need" — 4 vé dịch vụ xếp lệch.
 * Dùng chung ở trang chủ, About Us và Dịch Vụ nên đặt ở cấp components/.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = localizePath(routes.services, lang);

const tickets = [
  { label: t('home.services.s3.title'), tilt: '-rotate-2' },
  { label: t('home.services.s1.title'), tilt: 'rotate-1' },
  { label: t('home.services.s4.title'), tilt: 'rotate-2' },
  { label: t('home.services.s2.title'), tilt: '-rotate-1' },
];
---

<section class="py-14 md:py-20">
  <div class="container-g12">
    <h2 class="reveal text-2xl font-bold text-ink-strong sm:text-3xl md:text-[2.5rem]">
      {t('home.callus.title')}
    </h2>

    <ul class="mt-8 grid gap-5 md:mt-12 md:grid-cols-2 md:gap-6">
      {
        tickets.map((ticket) => (
          <li class:list={['reveal', ticket.tilt]}>
            <a
              href={href}
              class="group relative flex items-center justify-between gap-4 overflow-hidden rounded-2xl bg-linear-100 from-brand-yellow to-brand-ember px-6 py-6 shadow-[var(--shadow-card)] transition duration-300 hover:scale-[1.02] md:py-8"
            >
              {/* Răng cưa hai đầu vé */}
              <span
                class="absolute top-1/2 -left-3 size-6 -translate-y-1/2 rounded-full bg-surface"
                aria-hidden="true"
              />
              <span
                class="absolute top-1/2 -right-3 size-6 -translate-y-1/2 rounded-full bg-surface"
                aria-hidden="true"
              />
              <span class="text-sm font-bold text-white uppercase md:text-base">
                {ticket.label}
              </span>
              <span class="shrink-0 rounded-full bg-white/90 px-4 py-1.5 text-[0.7rem] font-bold text-brand-orange transition group-hover:bg-white">
                {t('cta.learnMore')}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
