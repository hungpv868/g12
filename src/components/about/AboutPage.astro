---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Marquee from '../Marquee.astro';
import CallUs from '../CallUs.astro';
import Glow from '../Glow.astro';
import Icon from '../Icon.astro';
import hero from '~/assets/about/hero.jpg';
import team from '~/assets/about/team.png';
import quotes from '~/assets/about/quotes.png';
import num1 from '~/assets/about/num-1.png';
import num2 from '~/assets/about/num-2.png';
import num3 from '~/assets/about/num-3.png';
import core1 from '~/assets/about/core-1-people.jpg';
import core2 from '~/assets/about/core-2-creativity.jpg';
import core3 from '~/assets/about/core-3-results.jpg';
import core4 from '~/assets/about/core-4-partnership.jpg';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

/**
 * About Us — Figma frame 1:433 (Desktop-1, 1440×6048), geo/aboutus.txt.
 * Structure: 1023px mosaic photo hero → yellow marquee → Our Story → Our Vision
 * (#FEF1C5 block) → ALL-IN-ONE marquee → 4 differentiator cards (285×335, HUMAN
 * highlighted with the #FFECB9→#EA4F26 gradient) → Commitment (orange #FF812C
 * block) → marquee → Call us → full footer.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Core Values — Company Profile pages 6–7. Client feedback (16/08, confirmed):
// the Figma REAL/HUMAN/EXPANSION/INNOVATION cards are replaced by this
// content; photos are the profile's own, extracted from the PDF.
const cores = [
  { img: core1, title: t('about.core.v1'), desc: t('about.core.v1Desc') },
  { img: core2, title: t('about.core.v2'), desc: t('about.core.v2Desc') },
  { img: core3, title: t('about.core.v3'), desc: t('about.core.v3Desc') },
  { img: core4, title: t('about.core.v4'), desc: t('about.core.v4Desc') },
];

const commits = [
  { num: num1, title: t('about.commit.c1'), desc: t('about.commit.c1Desc') },
  { num: num2, title: t('about.commit.c2'), desc: t('about.commit.c2Desc') },
  { num: num3, title: t('about.commit.c3'), desc: t('about.commit.c3Desc') },
];
---

<BaseLayout title={t('about.meta.title')} description={t('about.meta.description')}>
  <!-- Hero: the mosaic cover image already contains the logo + positioning, pulled up behind the header -->
  <section class="-mt-16 md:-mt-20">
    <h1 class="sr-only">{t('about.meta.title')}</h1>
    <Image
      src={hero}
      alt={lang === 'vi'
        ? 'G12 Media — đơn vị tiên phong cung cấp giải pháp quảng cáo, truyền thông và marketing all-in-one tại Việt Nam'
        : 'G12 Media — a pioneering all-in-one advertising, communications and marketing agency in Vietnam'}
      widths={[768, 1440, 2880]}
      sizes="100vw"
      loading="eager"
      class="max-h-[70vh] w-full object-cover md:aspect-[1440/1023] md:max-h-none"
    />
  </section>

  <Marquee variant="gold" />

  <!-- Our Story -->
  <section class="relative overflow-hidden py-12 md:py-16">
    <Glow side="left" top="55%" size="620px" />
    <div class="container-g12">
      <h2 class="reveal text-2xl font-bold text-ink-strong md:text-[2rem]">
        {t('about.story.title')}
      </h2>
      {/* Darker orange→red gradient instead of the brand yellow→orange one:
          the thin Corinthia strokes in yellow disappear into the cream page bg */}
      <p
        class="reveal mt-4 bg-linear-to-r from-brand-orange to-brand-deep bg-clip-text text-center font-script text-5xl leading-tight text-transparent sm:text-7xl md:text-[8rem]"
        style="filter: drop-shadow(0 4px 4px rgba(0,0,0,0.2))"
      >
        {t('about.story.script')}
      </p>

      <div class="mt-10 grid items-center gap-10 md:mt-14 lg:grid-cols-[757fr_560fr] lg:gap-14">
        <figure class="reveal relative mx-auto w-full max-w-[560px]">
          <Image
            src={team}
            alt={lang === 'vi' ? 'Đội ngũ G12 Media' : 'The G12 Media team'}
            widths={[560, 1120]}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="w-full"
          />
          <!-- Orange ellipse base + Since 2012 label (year per Company Profile; Figma said 2016) -->
          <div
            class="absolute bottom-1 left-1/2 -z-10 h-[38%] w-[92%] -translate-x-1/2 rounded-[50%] bg-linear-to-b from-brand-yellow to-brand-orange"
            aria-hidden="true"
          >
          </div>
          <figcaption
            class="absolute bottom-3 left-1/2 -translate-x-1/2 text-lg font-bold text-white md:text-2xl"
            style="text-shadow: var(--shadow-text)"
          >
            {t('about.story.since')}
          </figcaption>
        </figure>

        <div class="reveal flex flex-col gap-4 text-sm leading-relaxed md:text-[15px]">
          <p>{t('about.story.p1')}</p>
          <p>{t('about.story.p2')}</p>
          <p>{t('about.story.p3')}</p>

          <!-- Hero-style gradient pill with the arrow circle tucked against the right edge -->
          <a
            href={localizePath(routes.projects, lang)}
            class="group mt-4 inline-flex h-[52px] w-fit items-center gap-4 rounded-full bg-linear-to-r from-brand-yellow via-[#ff9f17] to-brand-orange py-1 pr-1 pl-7 text-sm font-bold text-white shadow-lg shadow-brand-orange/30 transition hover:brightness-105 md:h-[62px] md:pl-8"
          >
            {t('about.story.cta')}
            <span
              class="grid size-11 place-items-center rounded-full bg-surface-raised text-ink-strong shadow-md transition-transform duration-300 group-hover:translate-x-0.5 md:size-12"
            >
              <Icon name="arrowRight" size={18} />
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Vision: full-width cream-yellow block -->
  <section class="bg-[#fef1c5] py-12 md:py-16 dark:bg-[#2c2118]">
    <div class="container-g12">
      <h2 class="reveal text-2xl font-bold text-ink-strong md:text-[2rem]">
        {t('about.vision.title')}
      </h2>
      <div class="mt-8 grid gap-6 md:mt-10 md:grid-cols-[145px_1fr] md:gap-10">
        <Image
          src={quotes}
          alt=""
          width={145}
          densities={[1, 2]}
          loading="lazy"
          class="reveal w-20 md:w-[145px]"
        />
        <blockquote class="reveal">
          <p class="max-w-[900px] text-lg leading-relaxed font-medium text-ink-strong md:text-2xl">
            {t('about.vision.quote')}
          </p>
          <footer class="mt-8 text-right text-lg font-bold text-ink-strong md:text-2xl">
            {t('about.vision.sign')}
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <Marquee variant="gold" items={[t('about.allinone')]} />

  <!-- Core Values — replaces the Figma REAL/HUMAN/EXPANSION/INNOVATION cards
       per confirmed client feedback; cards highlight on hover, none statically -->
  <section class="relative overflow-hidden py-12 md:py-16">
    <Glow side="right" top="10%" size="700px" strong />
    <div class="container-g12">
      <h2
        class="reveal mx-auto max-w-[907px] text-center text-2xl leading-snug font-bold text-ink-strong md:text-[2rem]"
      >
        {t('about.core.title')}
      </h2>

      <ul class="mt-10 grid gap-5 sm:grid-cols-2 md:mt-14 xl:grid-cols-4">
        {
          /* hover gradient matches the home services cards — the paler Figma
             #ffecb9 start washed out the white text (client feedback) */
          cores.map((c, i) => (
            <li class="group reveal flex flex-col overflow-hidden rounded-[20px] bg-linear-to-b/srgb from-[#fef2c8] to-[#fef2c8] shadow-[0_4px_4px_rgba(0,0,0,0.25)] transition duration-300 hover:-translate-y-1 hover:from-[#ff9d4e] hover:to-[#f2703a]">
              <Image
                src={c.img}
                alt=""
                widths={[400, 800]}
                sizes="(min-width: 1280px) 285px, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                class="aspect-[3/2] w-full object-cover"
              />
              <div class="flex flex-1 flex-col gap-1.5 p-6">
                <p class="text-brand-gradient text-3xl font-extrabold transition duration-300 group-hover:[-webkit-text-fill-color:#fff]">
                  0{i + 1}.
                </p>
                <h3 class="text-xl font-bold text-black transition-colors duration-300 group-hover:text-white dark:text-black">
                  {c.title}
                </h3>
                <p class="text-sm leading-relaxed text-black transition-colors duration-300 group-hover:text-white dark:text-black">
                  {c.desc}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Our Commitment: solid orange block -->
  <section class="bg-[#ff812c] py-12 md:py-16 dark:bg-[#7a3c12]">
    <div class="container-g12">
      <h2 class="reveal text-center text-2xl font-bold text-white md:text-[2rem]">
        {t('about.commit.title1')}{' '}
        <span class="rounded-lg bg-brand-yellow px-2 text-ink-strong">
          {t('about.commit.title2')}
        </span>
      </h2>

      {/* Client feedback: the Figma 140px heading→items gap reads as a design
          mistake — tightened to 56px */}
      <ul class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-6 md:mt-14">
        {
          commits.map((c) => (
            <li class="reveal flex items-start gap-4">
              <Image
                src={c.num}
                alt=""
                width={68}
                densities={[1, 2]}
                loading="lazy"
                class="mt-1 w-14 shrink-0 md:w-[68px]"
              />
              <div class="text-white">
                <p class="text-sm">{t('about.commit.with')}</p>
                <p class="text-2xl font-bold uppercase md:text-[28px]">{c.title}</p>
                <p class="mt-1 text-sm text-white/90">{c.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Marquee variant="gold" />

  <CallUs />
</BaseLayout>
