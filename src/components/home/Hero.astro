---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import logoGradient from '~/assets/logo/g12-gradient.png';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const checks = [
  t('home.hero.check1'),
  t('home.hero.check2'),
  t('home.hero.check3'),
  t('home.hero.check4'),
] as const;
---

{/* Figma: vertical gradient background #FFD9B5 → #FFE5C4, extending up to the
    top of the page behind the transparent header. Negative margin pulls the
    section under the sticky header, then padding pushes the content back down. */}
<section
  class="-mt-16 bg-linear-to-b/srgb from-[#ffd9b5] to-[#ffe5c4] pt-16 md:-mt-20 md:pt-20 dark:from-[#2a1d12] dark:to-[#1d1610]"
>
  <div
    class="container-g12 grid items-center gap-8 py-12 md:py-16 lg:grid-cols-[1fr_411px] lg:gap-6 lg:py-0 lg:min-h-[580px]"
  >
    <div class="reveal">
      {/* H1 44px, 2 lines — Figma */}
      <h1
        class="text-[2rem] leading-[1.22] font-bold text-ink-strong sm:text-[2.5rem] lg:text-[2.75rem]"
      >
        {t('home.hero.title1')}<br />
        {t('home.hero.title2')}{' '}
        <span class="text-brand-accent">{t('home.hero.title3')}</span>
      </h1>

      {/* Short 154px rule above the description, not a left border */}
      <hr class="mt-7 w-[154px] border-0 border-t-2 border-ink-strong/70" />

      <p class="mt-4 max-w-[520px] text-sm leading-[1.65] text-ink-strong">
        {t('home.hero.desc')}
      </p>

      <ul class="mt-5 flex flex-col gap-[0.6rem]">
        {
          checks.map((label) => (
            <li class="flex items-start gap-2.5 text-sm font-semibold text-ink-strong">
              {/* Bare orange tick, no circular background */}
              <Icon
                name="check"
                size={17}
                strokeWidth={3}
                class="mt-px shrink-0 text-brand-accent"
              />
              {label}
            </li>
          ))
        }
      </ul>

      {/* Gradient pill with the arrow circle tucked against the right edge.
          Auto width — a fixed 248px left a dead stretch of gradient after the circle */}
      <a
        href={localizePath(routes.contact, lang)}
        class="group mt-8 inline-flex h-[52px] items-center gap-4 rounded-full bg-linear-to-r from-brand-yellow via-[#ff9f17] to-brand-orange py-1 pr-1 pl-7 text-sm font-bold text-white shadow-lg shadow-brand-orange/30 transition hover:brightness-105 md:h-[62px] md:pl-8"
      >
        {t('cta.consult')}
        <span
          class="grid size-11 place-items-center rounded-full bg-surface-raised text-ink-strong shadow-md transition-transform duration-300 group-hover:translate-x-0.5 md:size-12"
        >
          <Icon name="arrowRight" size={18} />
        </span>
      </a>
    </div>

    {/* Logo 411px on desktop; on mobile it moves up top and shrinks */}
    <div class="reveal order-first flex justify-center lg:order-none lg:justify-end">
      <Image
        src={logoGradient}
        alt="G12 Media"
        width={411}
        densities={[1, 2]}
        loading="eager"
        class="w-44 max-w-full sm:w-56 md:w-72 lg:w-[411px]"
      />
    </div>
  </div>
</section>
