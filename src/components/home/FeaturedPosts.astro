---
import { Image } from 'astro:assets';
import choisImg from '~/assets/posts/chois-glow-up.jpg';
import matiliaImg from '~/assets/posts/matilia-mommy.jpg';
import { categories } from '~/data/blog';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

/**
 * Figma: title at x122 y4722 with a 124px-wide Line 19 right below.
 * 2 cards 581×266 (x 123 and 750, 46px gap); each card has a ~268×226 image on
 * the left, category label + title + 195×47 button on the right.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// TODO: replace with the content collection once the Blog page is built
const posts = [
  {
    img: choisImg,
    category: categories.casestudy.label[lang],
    title:
      lang === 'vi'
        ? 'BẬT MÍ CÔNG THỨC "GLOW-UP" HÌNH ẢNH THƯƠNG HIỆU CHO CHOI\'S PILATES'
        : 'THE BRAND IMAGE "GLOW-UP" FORMULA FOR CHOI\'S PILATES',
    slug: 'bat-mi-cong-thuc-glow-up-choi-s-pilates',
  },
  {
    img: matiliaImg,
    category: categories.casestudy.label[lang],
    title:
      lang === 'vi'
        ? 'ĐỊNH HÌNH VỊ THẾ SỮA BẦU CAO CẤP CHO MATILIA MOMMY'
        : 'POSITIONING MATILIA MOMMY AS A PREMIUM PRENATAL MILK BRAND',
    slug: 'dinh-hinh-vi-the-sua-bau-cao-cap-matilia-mommy',
  },
];
---

<section class="py-12 md:py-16">
  <div class="container-g12">
    <h2 class="reveal text-xl font-bold text-ink-strong uppercase md:text-[1.75rem]">
      {t('home.posts.title')}
    </h2>
    <hr class="mt-2 w-[124px] border-0 border-t-2 border-brand-orange" />

    {/* 2 columns only from lg: at 768–1023px the fixed 268px image doesn't
        fit half the container and the card contents overflow */}
    <ul class="mt-7 grid gap-6 md:mt-9 lg:grid-cols-2 lg:gap-[46px]">
      {
        posts.map((post) => (
          <li class="reveal flex flex-col gap-5 rounded-[20px] bg-surface-sunken p-6 shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-1 sm:flex-row md:min-h-[266px]">
            <Image
              src={post.img}
              alt=""
              widths={[268, 536]}
              sizes="(min-width: 640px) 268px, 100vw"
              loading="lazy"
              class="aspect-[268/226] w-full shrink-0 rounded-[14px] object-cover sm:w-[268px]"
            />
            <div class="flex min-w-0 flex-col items-start">
              <span class="text-base font-bold text-ink-strong">{post.category}</span>
              <h3 class="mt-2 line-clamp-4 text-sm leading-snug font-bold text-brand-deep">
                {post.title}
              </h3>
              <a
                href={`${localizePath(routes.blog, lang)}/${post.slug}`}
                class="mt-auto inline-flex h-[47px] w-[195px] max-w-full items-center justify-center rounded-[30px] border border-[#d4d4d4] bg-linear-to-r from-[#ffbe02] via-[#ff9f17] to-[#ff842a] pt-4 text-base font-bold text-white shadow-[0_4px_10px_rgba(0,0,0,0.25)] transition hover:brightness-110 sm:mt-6 sm:pt-0"
              >
                {t('cta.learnMore')}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
