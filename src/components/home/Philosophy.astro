---
import Glow from '../Glow.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

/**
 * Figma: title + paragraph on the left (x 156, 609px wide), 449×259 quote
 * block on the right (x 780, y 3465) with a pointed tail toward bottom-right.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const points = [t('home.philosophy.i1'), t('home.philosophy.i2'), t('home.philosophy.i3')];
---

{/* Ellipse 3634/3635/3638 merge into a large glow on the right */}
<section class="relative overflow-hidden py-12 md:py-16">
  <Glow side="right" top="-10%" size="740px" strong />

  <div class="container-g12 grid items-center gap-10 lg:grid-cols-[609fr_449fr] lg:gap-12">
    <div class="reveal">
      <h2
        class="text-2xl leading-tight font-bold text-ink-strong uppercase sm:text-3xl md:text-[2.5rem]"
      >
        {t('home.philosophy.title')}
      </h2>
      <p class="mt-5 text-sm leading-relaxed md:text-base">{t('home.philosophy.desc')}</p>
      <ul class="mt-4 flex list-disc flex-col gap-2 ps-5 text-sm marker:text-brand-orange">
        {points.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <div class="reveal relative">
      <div
        class="grid min-h-[180px] place-items-center rounded-[24px] bg-surface-sunken px-8 py-10 text-center shadow-[var(--shadow-card)] md:min-h-[259px]"
      >
        <p class="text-xl leading-snug font-bold text-ink-strong md:text-[26px]">
          {t('home.philosophy.badge')}
        </p>
      </div>
      <span
        class="absolute -bottom-4 right-16 size-9 rotate-45 rounded-br-lg bg-surface-sunken"
        aria-hidden="true"></span>
    </div>
  </div>
</section>
