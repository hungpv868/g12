---
import { Image } from 'astro:assets';
import jinFitness from '~/assets/projects/jin-fitness.jpg';
import chois from '~/assets/projects/chois.jpg';
import matilia from '~/assets/projects/matilia.jpg';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

/**
 * Figma combines "Dịch vụ nổi bật" (featured services) and "Dự án tiêu biểu"
 * (featured projects) in the SAME seamless gradient block (Frame 4: y 747→2206,
 * #FFB326 → #FFFAEC), separated by Line 15. So both parts are built together
 * here instead of as separate sections.
 *
 * Original measurements (1440 frame):
 *  - Service cards 285×383, x = 123 / 425 / 728 / 1032 (~18px gap)
 *  - Card title 22px ExtraBold #E94B23, centered; body 14px Medium
 *  - Button 145×43, 30px radius, gradient #FFBE02 → #FF9F17 → #FF842A, #D4D4D4 border
 *  - Projects: cards 422×216 + 505×213 (24px gap), banner 951×226
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    title: t('home.services.s1.title'),
    items: [t('home.services.s1.i1'), t('home.services.s1.i2'), t('home.services.s1.i3')],
  },
  {
    title: t('home.services.s2.title'),
    items: [t('home.services.s2.i1'), t('home.services.s2.i2'), t('home.services.s2.i3')],
  },
  {
    title: t('home.services.s3.title'),
    items: [t('home.services.s3.i1'), t('home.services.s3.i2'), t('home.services.s3.i3')],
  },
  {
    title: t('home.services.s4.title'),
    items: [t('home.services.s4.i1'), t('home.services.s4.i2'), t('home.services.s4.i3')],
  },
];

const projectsHref = localizePath(routes.projects, lang);
const servicesHref = localizePath(routes.services, lang);

const projects = [
  { img: jinFitness, name: 'Jin Fitness', ratio: '422/216', w: 422 },
  { img: chois, name: "Choi's Pilates", ratio: '505/213', w: 505 },
];

/* `relative` is load-bearing: each button holds an absolutely-positioned
   sr-only span. Without a positioned ancestor the span escapes the slider's
   scroll clipping, lands ~1066px out, and mobile Chrome widens the whole
   layout viewport to fit it — the page becomes horizontally pannable. */
const btn =
  'relative inline-flex h-[43px] w-[145px] items-center justify-center rounded-[30px] border border-[#d4d4d4] bg-linear-to-r from-[#ffbe02] via-[#ff9f17] to-[#ff842a] text-base font-bold text-white shadow-[0_4px_10px_rgba(0,0,0,0.25)] transition hover:brightness-110';
---

<section class="bg-linear-to-b/srgb from-[#ffb326] to-[#fffaec] dark:from-[#4d3111] dark:to-[#16110d]">
  <!-- ══════ Featured services ══════ -->
  <div class="container-g12 pt-13 md:pt-[52px]">
    <h2
      class="reveal text-center text-2xl leading-tight font-bold text-ink-strong uppercase sm:text-3xl md:text-[2.375rem]"
    >
      {t('home.services.title1')}{' '}
      <span class="text-brand-deep">{t('home.services.title2')}</span>
    </h2>
    <p
      class="reveal mx-auto mt-3.5 max-w-[873px] text-center text-sm leading-relaxed text-ink-strong/90 md:text-base"
    >
      {t('home.services.desc')}
    </p>

    <ul
      class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain pb-4 md:mt-14 md:grid md:grid-cols-2 md:gap-[18px] md:overflow-visible md:pb-0 xl:grid-cols-4"
    >
      {
        services.map((s) => (
          <li
            class="reveal flex w-[76vw] max-w-[285px] shrink-0 snap-center flex-col items-center rounded-[20px] bg-linear-to-b from-[#ffeeb6] to-[#fef2c9] px-[25px] pt-9 pb-[38px] shadow-[0_4px_4px_rgba(0,0,0,0.25)] transition duration-300 hover:-translate-y-1 md:w-auto md:max-w-none xl:min-h-[383px]"
          >
            <h3 class="text-center text-[22px] leading-[1.25] font-extrabold text-brand-deep uppercase">
              {s.title}
            </h3>

            <ul
              class="mt-[26px] flex w-full flex-1 list-disc flex-col gap-4 ps-5 text-sm leading-snug font-medium text-black marker:text-black"
            >
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <a href={servicesHref} class:list={['mt-8', btn]}>
              {t('cta.learnMore')}
              <span class="sr-only">— {s.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Line 15: divider between the two parts, 1137px wide -->
  <div class="container-g12 pt-14 pb-12 md:pt-[124px] md:pb-[52px]">
    <hr class="mx-auto max-w-[1137px] border-0 border-t border-ink-strong/20" />
  </div>

  <!-- ══════ Featured projects ══════ -->
  <div class="container-narrow pb-14 md:pb-20">
    <h2
      class="reveal text-center text-2xl leading-tight font-bold text-ink-strong uppercase sm:text-3xl md:text-[2.375rem]"
    >
      {t('home.projects.title1')}{' '}
      <span class="text-brand-deep">{t('home.projects.title2')}</span>
    </h2>
    <p
      class="reveal mx-auto mt-3.5 max-w-[873px] text-center text-sm leading-relaxed text-ink-strong/90 md:text-base"
    >
      {t('home.projects.desc')}
    </p>

    <div class="mt-8 grid gap-6 md:mt-[70px] md:grid-cols-[422fr_505fr]">
      {
        projects.map((p) => (
          <a href={projectsHref} class="reveal group relative block overflow-hidden rounded-[18px]">
            <Image
              src={p.img}
              alt={`Dự án ${p.name}`}
              widths={[p.w, p.w * 2]}
              sizes={`(min-width: 768px) ${p.w}px, 100vw`}
              class="w-full object-cover object-top transition duration-500 group-hover:scale-105"
              style={`aspect-ratio:${p.ratio}`}
            />
            <span class:list={['absolute bottom-4 left-1/2 -translate-x-1/2', btn]}>
              {t('cta.learnMore')}
              <span class="sr-only">— {p.name}</span>
            </span>
          </a>
        ))
      }
    </div>

    <a href={projectsHref} class="reveal group relative mt-6 block overflow-hidden rounded-[18px]">
      <Image
        src={matilia}
        alt="Dự án Matilia Mommy"
        widths={[951, 1902]}
        sizes="(min-width: 1024px) 951px, 100vw"
        class="w-full object-cover transition duration-500 group-hover:scale-105"
        style="aspect-ratio:951/226"
      />
      <span class:list={['absolute bottom-4 left-1/2 -translate-x-1/2', btn]}>
        {t('cta.learnMore')}
        <span class="sr-only">— Matilia Mommy</span>
      </span>
    </a>
  </div>
</section>
