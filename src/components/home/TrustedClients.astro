---
import { Image } from 'astro:assets';
import photo from '~/assets/misc/trusted-clients.jpg';
import matilia from '~/assets/clients/matilia.png';
import chois from '~/assets/clients/chois.png';
import jinFitness from '~/assets/clients/jin-fitness.png';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

/**
 * Figma: full-bleed background photo (y 3912→4655), title x102 y4023 788px wide,
 * 3 logo cards 196×131 at x = 102 / 328 / 561.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const clients = [
  { img: matilia, name: 'Matilia Mommy' },
  { img: chois, name: "Choi's Pilates" },
  { img: jinFitness, name: 'Jin Fitness' },
];
---

<section class="relative overflow-hidden">
  <Image
    src={photo}
    alt=""
    widths={[512, 1024]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 size-full object-cover object-right"
  />
  <div class="absolute inset-0 bg-linear-to-r from-black/90 via-black/60 to-black/20"></div>

  {/* Figma: 744px-tall block (y 3912→4656) — content packed into the top half,
      the bottom left empty to let the photo of the person breathe */}
  <div class="container-g12 relative py-14 md:pt-[111px] md:pb-[300px]">
    <h2
      class="reveal max-w-[788px] text-2xl leading-[1.35] font-bold text-brand-yellow uppercase sm:text-3xl md:text-[2.5rem]"
      style="text-shadow: var(--shadow-text)"
    >
      {t('home.trust.title1')}{' '}<br class="hidden sm:block" />{t('home.trust.title2')}
    </h2>

    <ul class="reveal mt-8 flex flex-wrap gap-4 md:mt-[70px] md:gap-[30px]">
      {
        clients.map((c) => (
          <li class="h-[92px] w-[140px] rounded-[14px] bg-white p-4 shadow-xl md:h-[131px] md:w-[196px] md:p-6">
            <Image
              src={c.img}
              alt={c.name}
              width={196}
              densities={[1, 2]}
              loading="lazy"
              class="size-full object-contain"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
