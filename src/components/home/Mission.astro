---
import Mission1 from '~/assets/icons/mission-1.svg';
import Mission2 from '~/assets/icons/mission-2.svg';
import Mission3 from '~/assets/icons/mission-3.svg';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

/**
 * Figma: tiêu đề canh giữa (y 2907), 3 cột rộng 405px tại x = 123 / 576 / 1008,
 * icon minh hoạ gradient đặt phía trên mỗi cột (export SVG từ Figma),
 * kết thúc bằng Line 14 rộng 805px canh giữa.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  { Icon: Mission1, text: t('home.mission.m1') },
  { Icon: Mission2, text: t('home.mission.m2') },
  { Icon: Mission3, text: t('home.mission.m3') },
];
---

<section class="pt-14 pb-10 md:pt-[70px] md:pb-14">
  <div class="container-g12">
    <h2
      class="reveal text-center text-2xl leading-tight font-bold text-ink-strong uppercase sm:text-3xl md:text-[2.5rem]"
    >
      {t('home.mission.title')}
    </h2>

    <ul class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-6 md:mt-[86px]">
      {
        items.map(({ Icon, text }) => (
          <li class="reveal flex flex-col items-center gap-7 text-center">
            <Icon class="h-[110px] w-auto md:h-[140px]" />
            <p class="max-w-[405px] text-sm leading-relaxed">{text}</p>
          </li>
        ))
      }
    </ul>

    <hr class="mx-auto mt-10 max-w-[805px] border-0 border-t border-ink-strong/15 md:mt-14" />
  </div>
</section>
