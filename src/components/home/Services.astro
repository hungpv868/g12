---
import Icon from '../Icon.astro';
import SectionTitle from '../SectionTitle.astro';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    title: t('home.services.s1.title'),
    items: [t('home.services.s1.i1'), t('home.services.s1.i2'), t('home.services.s1.i3')],
    featured: false,
  },
  {
    title: t('home.services.s2.title'),
    items: [t('home.services.s2.i1'), t('home.services.s2.i2'), t('home.services.s2.i3')],
    featured: true, // card gradient đậm nổi bật giữa hàng, theo thiết kế
  },
  {
    title: t('home.services.s3.title'),
    items: [t('home.services.s3.i1'), t('home.services.s3.i2'), t('home.services.s3.i3')],
    featured: false,
  },
  {
    title: t('home.services.s4.title'),
    items: [t('home.services.s4.i1'), t('home.services.s4.i2'), t('home.services.s4.i3')],
    featured: false,
  },
];
---

<section class="bg-linear-180 from-brand-yellow to-brand-orange py-14 md:py-20">
  <div class="container-g12">
    <SectionTitle
      lead={`${t('home.services.title1')} `}
      accent={t('home.services.title2')}
      desc={t('home.services.desc')}
      onBrand
    />

    <!-- Mobile: cuộn ngang giữ được nhịp "lướt qua các dịch vụ" của bản desktop.
         Từ md trở lên chuyển thành lưới. -->
    <ul
      class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 md:mt-14 md:grid md:grid-cols-2 md:overflow-visible md:pb-0 xl:grid-cols-4"
      style="scrollbar-width: thin"
    >
      {
        services.map((s) => (
          <li
            class:list={[
              'reveal flex w-[80vw] max-w-xs shrink-0 snap-center flex-col rounded-3xl p-6 shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-1.5 md:w-auto md:max-w-none',
              s.featured
                ? 'bg-linear-160 from-brand-orange to-brand-ember text-white'
                : 'bg-surface-raised',
            ]}
          >
            <h3
              class:list={[
                'text-lg font-bold uppercase',
                s.featured ? 'text-white' : 'text-brand-accent',
              ]}
            >
              {s.title}
            </h3>

            <ul class="mt-4 flex flex-1 flex-col gap-2.5">
              {s.items.map((item) => (
                <li
                  class:list={[
                    'flex items-start gap-2 text-sm leading-relaxed',
                    s.featured ? 'text-white/90' : 'text-ink',
                  ]}
                >
                  <span
                    class:list={[
                      'mt-1.5 size-1.5 shrink-0 rounded-full',
                      s.featured ? 'bg-white' : 'bg-brand-orange',
                    ]}
                  />
                  {item}
                </li>
              ))}
            </ul>

            <a
              href={localizePath(routes.services, lang)}
              class:list={[
                'mt-6 inline-flex w-fit items-center gap-2 rounded-full px-5 py-2 text-xs font-bold transition hover:gap-3',
                s.featured
                  ? 'bg-white text-brand-orange'
                  : 'bg-brand-gradient text-white',
              ]}
            >
              {t('cta.learnMore')}
              <Icon name="arrowRight" size={13} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
