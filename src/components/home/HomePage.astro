---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CallUs from '../CallUs.astro';
import Hero from './Hero.astro';
import ServicesProjects from './ServicesProjects.astro';
import WhoWeAre from './WhoWeAre.astro';
import Mission from './Mission.astro';
import Philosophy from './Philosophy.astro';
import TrustedClients from './TrustedClients.astro';
import FeaturedPosts from './FeaturedPosts.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

/**
 * Home page content shared by both `/` (vi) and `/en/`.
 * Language is inferred from the URL, so no prop is needed.
 */
const t = useTranslations(getLangFromUrl(Astro.url));
---

<BaseLayout title={t('home.meta.title')} description={t('home.meta.description')}>
  {/* The home page in Figma has NO marquee strip — the "…Solution ✦" strip
      only appears on About Us. Do not add it here. */}
  <Hero />
  <ServicesProjects />
  <WhoWeAre />
  <Mission />
  <Philosophy />
  <TrustedClients />
  <FeaturedPosts />
  <CallUs />
</BaseLayout>
