---
/**
 * Runs synchronously before paint to avoid a white flash when entering the site in dark mode.
 * Not module/defer — deliberately blocks render for a very short beat.
 */
---

<script is:inline>
  (() => {
    const stored = localStorage.getItem('g12-theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = stored ?? (prefersDark ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    // Gate for the reveal effect: without JS the content is visible up front
    document.documentElement.classList.add('js');
  })();
</script>
