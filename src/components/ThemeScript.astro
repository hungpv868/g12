---
/**
 * Chạy đồng bộ trước khi vẽ để tránh nháy trắng khi vào site ở chế độ tối.
 * Không dùng module/defer — cố ý chặn render một nhịp cực ngắn.
 */
---

<script is:inline>
  (() => {
    const stored = localStorage.getItem('g12-theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = stored ?? (prefersDark ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    // Gate cho hiệu ứng reveal: không có JS thì nội dung hiện sẵn
    document.documentElement.classList.add('js');
  })();
</script>
