---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoWhite from '~/assets/logo/g12-white.png';
import { getLangFromUrl, localizePath, routes, useTranslations } from '~/i18n/utils';
import { site } from '~/config/site';

/* The Figma design has a second "compact" footer for blog/projects/contact
   (DESIGN.md 1.3), but the client asked (16/08 feedback) for the SAME full
   footer on every page — so the variant system is gone on purpose. */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const socials = [
  { name: 'facebook' as const, href: site.social.facebook, label: 'Facebook' },
  { name: 'tiktok' as const, href: site.social.tiktok, label: 'TikTok' },
];

const contacts = [
  { name: 'phone' as const, text: site.phone, href: `tel:${site.phone.replace(/[^\d+]/g, '')}` },
  { name: 'mail' as const, text: site.email, href: `mailto:${site.email}` },
  { name: 'globe' as const, text: site.url, href: `https://${site.url}` },
  {
    name: 'mapPin' as const,
    text: t('footer.address'),
    href: `https://maps.google.com/?q=${encodeURIComponent(site.address)}`,
  },
];
---

<footer class="bg-brand-gradient text-white">
  {/* Figma: footer block y 5857→6522. "Let's Connect" title sits 91px from
      the top edge, Line 5 at 6045, content 6090→6320, Line 20 at 6396 */}
  <div class="container-g12 py-10 md:pt-[91px] md:pb-0">
    <div
      class="flex flex-col gap-5 border-b border-white/25 pb-8 sm:flex-row sm:items-center sm:justify-between md:pb-[52px]"
    >
      <h2 class="text-3xl font-bold md:text-5xl">
        {t('footer.connect1')} <span class="text-white/60">{t('footer.connect2')}</span>{' '}
        {t('footer.connect3')}
      </h2>
      <a
        href={localizePath(routes.contact, lang)}
        class="inline-flex w-fit shrink-0 items-center gap-2.5 rounded-full bg-surface-raised px-6 py-3 text-sm font-bold text-brand-orange shadow-lg transition hover:scale-105"
      >
        {t('cta.consult')}
        <Icon name="arrowRight" size={18} />
      </a>
    </div>

    <div class="grid gap-8 pt-8 md:grid-cols-3 md:gap-10 md:pt-[45px] md:pb-[76px]">
      <div class="flex flex-col gap-4">
        {/* Figma: logo footer 302×165. Width is the pinned axis (h-auto keeps
            the ratio) — with a pinned height + w-auto, lazy-loaded images can
            stretch to the container width and squash the logo flat. */}
        <Image
          src={logoWhite}
          alt="G12 Media"
          width={302}
          densities={[1, 2]}
          class="h-auto w-[180px] md:w-[302px]"
        />
        <div class="flex gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid size-9 place-items-center rounded-full bg-black/85 text-white transition hover:scale-110"
              >
                <Icon name={s.name} size={17} />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="mb-4 text-lg font-bold">{t('footer.contact')}</h3>
        <ul class="flex flex-col gap-2.5 text-sm md:inline-flex">
          {
            contacts.map((c) => (
              <li>
                <a href={c.href} class="flex items-center gap-3 transition hover:opacity-75">
                  <Icon name={c.name} size={16} class="shrink-0" />
                  <span>{c.text}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-lg font-bold">{t('footer.newsletter')}</h3>
        {/* Netlify Forms handles this server-side, no separate backend needed */}
        <form
          name="newsletter"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="flex items-center gap-2 rounded-full bg-surface-raised p-1.5 pl-5"
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hidden">
            <label>
              Do not fill this in: <input name="bot-field" />
            </label>
          </p>
          <label for="newsletter-email" class="sr-only">
            {t('footer.emailPlaceholder')}
          </label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            placeholder={t('footer.emailPlaceholder')}
            class="min-w-0 flex-1 bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted focus:outline-none"
          />
          <button
            type="submit"
            aria-label={t('footer.subscribe')}
            class="bg-brand-gradient grid size-9 shrink-0 place-items-center rounded-full text-white transition hover:scale-105"
          >
            <Icon name="send" size={15} />
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="border-t border-white/25">
    <div
      class="container-g12 flex flex-col gap-3 py-4 text-xs sm:flex-row sm:items-center sm:justify-between md:py-[38px]"
    >
      <p>{t('footer.copyright')} {year} {t('footer.rights')}</p>
      <div class="flex gap-6">
        <a href={localizePath('/terms', lang)} class="transition hover:opacity-75">
          {t('footer.terms')}
        </a>
        <a href={localizePath('/privacy', lang)} class="transition hover:opacity-75">
          {t('footer.privacy')}
        </a>
      </div>
    </div>
  </div>
</footer>
