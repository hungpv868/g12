---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

interface Props {
  /** Repeat a fixed string instead of the 4 default solutions */
  items?: string[];
  /**
   * `brand` — deep orange gradient (default).
   * `gold` — pale yellow gradient #FEE8A3→#FFD24C used on the About Us page.
   */
  variant?: 'brand' | 'gold';
  class?: string;
}

const t = useTranslations(getLangFromUrl(Astro.url));
const { items, variant = 'brand', class: className = '' } = Astro.props;

const labels = items ?? [
  t('marquee.marketing'),
  t('marquee.digital'),
  t('marquee.advertising'),
  t('marquee.creative'),
];

// Doubled so the translateX(-50%) loop connects seamlessly
const track = [...labels, ...labels];
---

<div
  class:list={[
    'overflow-hidden py-3 md:py-4',
    variant === 'gold'
      ? 'bg-linear-to-b/srgb from-[#fee8a3] to-[#ffd24c] dark:from-[#4a3a10] dark:to-[#3a2c0a]'
      : 'bg-brand-gradient',
    className,
  ]}
  role="presentation"
>
  <div class="marquee-track flex w-max items-center gap-6 md:gap-10">
    {
      track.map((label) => (
        <>
          <span
            class="text-base font-bold whitespace-nowrap text-white md:text-2xl lg:text-[2rem]"
            style="text-shadow: var(--shadow-text)"
          >
            {label}
          </span>
          <Icon name="sparkle" size={18} class="shrink-0 fill-white text-white" strokeWidth={1} />
        </>
      ))
    }
  </div>
</div>
