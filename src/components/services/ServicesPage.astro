---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Marquee from '../Marquee.astro';
import Glow from '../Glow.astro';
import { serviceBlocks, serviceLabels } from '~/data/services';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

/**
 * Services — the SIX categories from Company Profile section II (2.1–2.6),
 * per client feedback 16/08 (replaces the old 4 Figma blocks). The client
 * asked to keep the ORIGINAL Figma block design — accent title, intro
 * paragraph, plain bullet list, alternating square image, gold marquees —
 * so only the content changed, not the form.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = serviceLabels[lang];
const blocks = serviceBlocks[lang];

const images = import.meta.glob<{ default: ImageMetadata }>('~/assets/services/*.jpg', {
  eager: true,
});
const img = (name: string): ImageMetadata => {
  const hit = Object.entries(images).find(([path]) => path.endsWith(`/${name}.jpg`));
  if (!hit) throw new Error(`Missing service image: ${name}`);
  return hit[1].default;
};
---

<BaseLayout title={t('services.meta.title')} description={t('home.services.desc')}>
  <section class="container-g12 pt-10 pb-4 md:pt-[68px]">
    <h1
      class="reveal text-center text-3xl leading-tight font-bold text-ink-strong uppercase sm:text-4xl md:text-5xl"
    >
      {t('home.services.title1')}{' '}
      <span class="text-brand-deep">{t('home.services.title2')}</span>
    </h1>
    <p class="reveal mx-auto mt-4 max-w-[873px] text-center text-sm text-ink-muted md:text-[15px]">
      {L.intro}
    </p>
  </section>

  {
    blocks.map((block, i) => (
      <>
        <section class="relative overflow-hidden py-10 md:py-14">
          <Glow side={i % 2 ? 'left' : 'right'} top="15%" size="640px" strong={i % 2 === 0} />

          <div
            class:list={[
              'container-g12 grid items-center gap-8 lg:gap-16',
              i % 2 === 0 ? 'lg:grid-cols-[653fr_494fr]' : 'lg:grid-cols-[494fr_653fr]',
            ]}
          >
            <div class:list={['reveal', i % 2 === 1 && 'lg:order-2']}>
              <h2 class="text-2xl leading-tight font-extrabold text-brand-accent uppercase sm:text-3xl md:text-[2.5rem]">
                {block.title}
              </h2>
              <div class="mt-4 flex flex-col gap-1 text-sm leading-relaxed md:text-[15px]">
                <p>{block.intro}</p>
              </div>
              <ul class="mt-5 flex list-disc flex-col gap-2.5 ps-5 text-sm leading-relaxed marker:text-ink-strong md:text-[15px]">
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <div class:list={['reveal', i % 2 === 1 && 'lg:order-1']}>
              <Image
                src={img(block.img)}
                alt={block.title}
                widths={[494, 988]}
                sizes="(min-width: 1024px) 494px, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="mx-auto w-full max-w-[494px] rounded-[24px] object-cover shadow-[var(--shadow-card)]"
              />
            </div>
          </div>
        </section>

        {i < blocks.length - 1 && <Marquee variant="gold" />}
      </>
    ))
  }
</BaseLayout>
