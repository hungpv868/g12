---
/**
 * Decorative glow — Figma scatters several large blurred ellipses behind the content
 * (Ellipse 20/21/3630/3632/3634/3635/3637/3638) so the cream background isn't flat.
 * Measured: left glow ~#FFF5D7, right one darker ~#FFE4B4, on the #FFFBEE background.
 *
 * Place inside a section with `relative` (and usually `overflow-hidden`).
 */
interface Props {
  /** Which section edge to anchor to */
  side: 'left' | 'right';
  /** Distance from the section's top edge, e.g. '10%' or '120px' */
  top: string;
  /** Diameter, e.g. '660px' */
  size: string;
  /** Darker variant for the right-side glows */
  strong?: boolean;
  class?: string;
}

const { side, top, size, strong = false, class: className = '' } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    'pointer-events-none absolute -z-10 rounded-full blur-[70px]',
    strong ? 'opacity-70 dark:opacity-[0.13]' : 'opacity-60 dark:opacity-[0.10]',
    className,
  ]}
  style={`
    ${side}: -8%;
    top: ${top};
    width: ${size};
    height: ${size};
    background: radial-gradient(circle, ${strong ? '#ffd9a0' : '#fff0c8'} 0%, transparent 70%);
  `}
>
</div>
